# Copy this file to .env. Do not commit .env.
# These values are resource names and endpoints, never passwords or access tokens.

FOUNDRY_PROJECT_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_MODEL=MODEL-DEPLOYMENT-NAME
FOUNDRY_AGENT_NAME=fabrikam-service-operations-agent

# Used in later exercises.
FOUNDRY_IQ_MCP_ENDPOINT=
LOCAL_MCP_ENDPOINT=http://127.0.0.1:8000/mcp

# Prompt Agents can require an explicit version. Leave blank until instructed.
FOUNDRY_AGENT_VERSION=
